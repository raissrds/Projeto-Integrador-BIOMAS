{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "Compilar e abrir prototipo",
                      "problemMatcher":  [

                                         ],
                      "command":  "C:/msys64/usr/bin/bash.exe",
                      "type":  "process",
                      "args":  [
                                   "-c",
                                   "export PATH=/ucrt64/bin:/usr/bin:$PATH; gcc -std=c11 -Wall -Wextra -g main.c movimento.c -o prototipo.exe $(pkg-config --cflags --libs allegro-5 allegro_primitives-5) \u0026\u0026 ./prototipo.exe"
                               ],
                      "options":  {
                                      "cwd":  "${workspaceFolder}"
                                  },
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  }
              ]
}
